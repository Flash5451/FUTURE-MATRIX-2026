# ── Google Sheets ─────────────────────────────────────────────────────────
# The spreadsheet that stores every registration.
# From the URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=1leEc_D4N2WlqB-ohLy6HQ1255MCwUwUAr1-GGNbBKCs

# Name of the tab inside that spreadsheet the app should read/write.
# The app auto-creates the header row on this tab if it's missing.
GOOGLE_SHEETS_TAB_NAME=Sheet1

# ── Google Service Account (used for Sheets only) ───────────────────────────
# Create in Google Cloud Console → IAM & Admin → Service Accounts → Keys → Add key (JSON).
# Enable the "Google Sheets API" for the project first.
# Share the spreadsheet with this service account's email as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Paste the full private_key value from the downloaded JSON key, including
# -----BEGIN PRIVATE KEY----- / -----END PRIVATE KEY-----.
# Keep it on one line wrapped in double quotes with literal \n for newlines
# (this is exactly how it appears in the downloaded JSON file).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Google Drive ──────────────────────────────────────────────────────────
# Not used. Abstract PDF / PPT links are pasted directly into the form by
# each team (see SETUP.md) — no Drive upload API or folder ID needed, since
# service accounts have no storage quota on personal (non-Workspace) Gmail
# accounts.
